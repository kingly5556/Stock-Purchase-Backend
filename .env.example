# Must match the root ERPHUB app's JWT_SECRET exactly — this module only verifies
# tokens issued by ERPHUB, it never signs its own.
JWT_SECRET=replace-with-a-long-random-secret

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/k_erp_stock?schema=public

PORT=4001

# PO totals above this (in satang, i.e. THB x 100) require Manager approval
# before moving from PENDING_APPROVAL to APPROVED. 50000 THB = 5000000 satang.
APPROVAL_THRESHOLD_SATANG=5000000

# Optional: where the built SPA lives (default: ../Stock-Purchase-Frontend/dist)
# FRONTEND_DIST=../Stock-Purchase-Frontend/dist

# --- Accounting integration (optional) -------------------------------------------------
# Goods receipts and stock adjustments are written to an outbox table in the same
# transaction, then delivered to the Accounting module's POST /api/postings by a worker.
# Leave these unset to run Stock on its own: events simply wait in the outbox (PENDING).
# ACCOUNTING_URL=http://localhost:4002
# Must equal ACCOUNTING_SERVICE_KEY in Accounting-Backend/.env. Never log or commit it.
# ACCOUNTING_SERVICE_KEY=replace-with-another-long-random-secret
# Set to "off" to stop this process from running the outbox worker.
# OUTBOX_WORKER=off
